# Prometheus
PROM_URL=http://prometheus:9090
PROM_TIMEOUT=10

# DeepSeek
API_KEY=sk-xxxxxxxx
API_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
AI_TIMEOUT=30
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3

# 企业微信
WECOM_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# 服务端口
WEBHOOK_PORT=8080

# 两段式通知并发：基础告警线程数 / AI 分析线程数
NOTIFY_WORKERS=4
ANALYSIS_WORKERS=2

# 快照参数
# CPU/内存：查询 10 分钟前、5 分钟前、3 分钟前、1 分钟前、30 秒前和当前
# 磁盘：7 个点 × 600 秒，覆盖约 1 小时，最新点延迟 30 秒
SNAPSHOT_CPU_MEM_OFFSETS=600,300,180,60,30,0
SNAPSHOT_DELAY=30
SNAPSHOT_DISK_N=7
SNAPSHOT_DISK_STEP=600