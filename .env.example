# Prometheus
PROM_URL=http://prometheus:9090
PROM_TIMEOUT=10

# DeepSeek
API_KEY=sk-xxxxxxxx
API_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
AI_TIMEOUT=30
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3

# 企业微信
WECOM_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# 去重冷却（秒）
COOLDOWN=300

# 服务端口
WEBHOOK_PORT=8080

# 快照参数：最近 N 个时间点，间隔 step 秒
SNAPSHOT_N=5
SNAPSHOT_STEP=30